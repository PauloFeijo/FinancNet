@page "/category"
@inject ICategoryService _categoryService
@inject NavigationManager NavigationManager

<h2>Categorias</h2>

<div>
    <a class="btn btn-success" href="category/create">Nova Categoria</a>
</div>
<br />

@if (categories is not null)
{
    <table class="table table-striped">
        <thead> 
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Nome</th>
                <th scope="col">Tipo</th>
                <th scope="col">Categoria Pai</th>
                <th scope="col"></th>
            </tr></thead>
        <tbody>
            @foreach (var category in categories)
            {
                <tr>
                    <td>@category.Id</td>
                    <td>@category.Description</td>
                    <td>@category.Type.GetDescription()</td>
                    <td>@category.ParentId</td>
                    <td>
                        <a class="btn btn-primary" href="category/edit/@category.Id">Editar</a> 
                        <a class="btn btn-danger" @onclick="@(()=> Delete(category.Id))" style=" color : white">Excluir</a> 
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <DisplayMessage ErrorMessage="Não foi possível acessar categorias !!!" />
}
<div>
    <DisplayMessage ErrorMessage="@errorMessage" />
</div>

<ModalDialog @ref="modalDialog" onCancel="DeleteCancel" onConfirm="DeleteConfirm" Title="Exclusão">
    <div>Deseja realmente excluir este item ?</div>
</ModalDialog>

@code {
    private IEnumerable<CategoryDto> categories = new List<CategoryDto>();

    private string? errorMessage;

    ModalDialog? modalDialog;
    long categorytId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadCategories();
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("notauthorized");
        }
    }

    async Task LoadCategories()
    {
        categories = await _categoryService.GetAll();
    }

    void Delete(long id)
    {
        modalDialog.Show();
        categorytId = id;
    }

    void DeleteCancel()
    {
        modalDialog.Hide();
    }

    async Task DeleteConfirm()
    {
        await _categoryService.Delete(categorytId);
        modalDialog.Hide();
        await LoadCategories();
    }
}